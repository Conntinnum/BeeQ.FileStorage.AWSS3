<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>BeeQ.FileStorage.AWSS3</PackageId>
		<Version>1.0.0</Version>
		<Authors>BeeQ</Authors>
		<Description>Simplifies the storage of files in AWS S3 as Extension of BeeQ.FileStorage</Description>
		<RepositoryUrl>https://github.com/Conntinnum/BeeQ.FileStorage.AWSS3</RepositoryUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageIcon>BeeQ.FileStorage.AWSS3.png</PackageIcon>
		<Title>BeeQ.FileStorage.AWSS3</Title>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<None Remove=".gitignore" />
		<None Remove="desktop.ini" />
	</ItemGroup>

	<ItemGroup>
		<None Include="BeeQ.FileStorage.AWSS3.png" Pack="true" PackagePath="" />
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="AWSSDK.S3" Version="4.0.102.5" />
	  <PackageReference Include="BeeQ.FileStorage" Version="1.3.0" />
	</ItemGroup>
</Project>
